# =============================================================================
# TravelDoc — Environment Variables
# Copy this file to .env and fill in values before running.
# NEVER commit .env to version control.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://traveldoc:traveldoc@db:5432/traveldoc
DATABASE_URL_SYNC=postgresql+psycopg2://traveldoc:traveldoc@db:5432/traveldoc

# --- Admin panel (SQLAdmin at /admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- API security ---
SECRET_KEY=change-this-to-a-random-secret-in-production

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- City config (replace for each deployment city) ---
CITY_NAME=Goa, India
CITY_CENTER_LAT=15.4909
CITY_CENTER_LNG=73.8278
CITY_CURRENCY=INR
CITY_EMERGENCY_NUMBER=112

# --- Feature flags ---
IS_DEMO_DATA=true
MAX_RADIUS_KM=10

# --- OpenRouter LLM Search (server-side only) ---
LLM_SEARCH_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
